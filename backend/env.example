# Backend Supabase service role configuration required by backend/db/supabase.js
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Agent 8 Omnichannel Communication Engine (do not commit real secrets)
COMMUNICATION_ENGINE_ENABLED=true
COMMUNICATION_WORKER_ENABLED=true
COMMUNICATION_WORKER_SECRET=
CRON_SECRET=
COMMUNICATION_WORKER_BATCH_SIZE=10
COMMUNICATION_PROCESSING_STALE_SECONDS=900
COMMUNICATION_MAX_ATTEMPTS=5
COMMUNICATION_RETRY_BASE_MS=60000
COMMUNICATION_AI_MODE_DEFAULT=enabled
COMMUNICATION_SLA_URGENT_MINUTES=15
COMMUNICATION_SLA_HIGH_MINUTES=60
COMMUNICATION_SLA_NORMAL_MINUTES=480
COMMUNICATION_SLA_LOW_MINUTES=1440
COMMUNICATION_FAKE_ADAPTERS_ENABLED=false
CARUP_COMMUNICATION_WEBHOOK_UAT_DIAGNOSTICS=false
COMMUNICATION_WEBHOOK_BASE_URL=
CARUP_PUBLIC_API_URL=
CARUP_CHANNEL_WEBHOOK_SECRET=
CARUP_META_WEBHOOK_VERIFY_TOKEN=
CARUP_META_APP_SECRET=
CARUP_META_ACCESS_TOKEN=
CARUP_META_PHONE_NUMBER_ID=
CARUP_META_PAGE_ID=
CARUP_TELEGRAM_BOT_TOKEN=
CARUP_TELEGRAM_WEBHOOK_SECRET_TOKEN=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=CarUp
SENDGRID_EVENT_WEBHOOK_VERIFICATION_KEY=
EMAIL_PROVIDER=sendgrid
EMAIL_PROVIDER_FALLBACK=

# --- Email 1.0 canonical transports (directive §0A) --------------------------
# Resend = transactional + conversational Email on mail.carup.dev.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@mail.carup.dev
RESEND_WEBHOOK_SECRET=
# Brevo = MARKETING ONLY on marketing.carup.dev. Never a competing transactional provider.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_WEBHOOK_SECRET=

# Free-tier quota governance (see backend/config/emailProviderQuota.js).
# Soft warns; critical preserves security/transactional/conversational capacity, defers
# lower-priority Email, suppresses marketing first, and never auto-purchases capacity.
RESEND_DAILY_SOFT_LIMIT=
RESEND_DAILY_CRITICAL_LIMIT=
BREVO_DAILY_SOFT_LIMIT=
BREVO_DAILY_CRITICAL_LIMIT=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=
CLOUDFLARE_EMAIL_FROM_NAME=CarUp
CLOUDFLARE_EMAIL_REPLY_TO=
CLOUDFLARE_EMAIL_WORKER_URL=
CLOUDFLARE_EMAIL_WORKER_SECRET=
CLOUDFLARE_EMAIL_INBOUND_SECRET=
CLOUDFLARE_EMAIL_ALLOWED_RECIPIENTS=
CLOUDFLARE_EMAIL_MAX_BYTES=26214400
CLOUDFLARE_EMAIL_SIGNATURE_TOLERANCE_SECONDS=300
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_QUEUE_INBOUND=
CLOUDFLARE_QUEUE_OUTBOUND=
CLOUDFLARE_QUEUE_DLQ=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=

# Optional OCR/provider configuration
OCR_MODE=loose
OCR_PRIMARY_PROVIDER=gemini
OCR_FALLBACK_PROVIDER=groq
ALLOW_OCR_MOCK=true
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional event worker database URL. Do not hard-code production credentials in source.
DATABASE_URL=postgresql://USER:PASS@db.example.supabase.co:5432/postgres

# Optional automation hooks
ENABLE_AUTOMATION_WEBHOOKS=false
AUTOMATION_PROVIDER=n8n
AUTOMATION_WEBHOOK_URL=

# Optional live Diaspora Supabase integration validation
# RUN_DIASPORA_SUPABASE_INTEGRATION=true
# APPLY_DIASPORA_MIGRATION=true
# SUPABASE_DB_URL=postgresql://USER:PASS@db.example.supabase.co:5432/postgres

# Diaspora Trade OS — Phase 7 Google Drive integration (no real values; see docs)
# DIASPORA_DRIVE_ENABLED=false            # feature flag; must be true to expose Drive endpoints
# DIASPORA_DRIVE_MOCK=false               # force the in-memory mock provider (tests/dev)
# DIASPORA_DRIVE_STATE_SECRET=            # HMAC secret for signing OAuth state (set in prod)
# GOOGLE_CLIENT_ID=                       # Google OAuth client id (external activation)
# GOOGLE_CLIENT_SECRET=                   # Google OAuth client secret (NEVER commit a real value)
# GOOGLE_DRIVE_REDIRECT_URI=              # OAuth callback, e.g. https://app.example.com/api/diaspora/drive/google/callback

# ── Diaspora Google Drive (Issue #127) ───────────────────────────────────────
# Live Drive stays OFF without these. The provider fails closed rather than degrading.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_DRIVE_REDIRECT_URI=             # must match the Google console entry BYTE-FOR-BYTE
# GOOGLE_DRIVE_REDIRECT_URIS=            # optional: additional callbacks, comma separated
# DIASPORA_DRIVE_STATE_SECRET=           # signs the one-time OAuth state; fails closed without it
# DIASPORA_DRIVE_ENABLED=false
# DIASPORA_DRIVE_MAX_SYNC_ATTEMPTS=5     # retries before a sync attempt is dead-lettered
#
# Credential vault. REQUIRED in production: resolveVault() throws VAULT_NOT_CONFIGURED without it and
# never falls back to the in-memory store — a token must never live in a volatile process.
# DIASPORA_CREDENTIAL_VAULT_BACKEND=     # aws_secrets_manager | gcp_secret_manager | azure_key_vault
#                                        #   | hashicorp_vault | supabase_vault

# ── Diaspora subscription billing (Issue #127) ───────────────────────────────
# Test mode only. APPROVED_LIVE_PROVIDERS is empty, so live billing fails closed regardless.
# DIASPORA_BILLING_TEST_MODE=false
# DIASPORA_BILLING_PROVIDER=
# DIASPORA_BILLING_WEBHOOK_SECRET=
# DIASPORA_BILLING_RECONCILIATION_SCHEDULER=false   # reconciliation sweep is operator-triggered until on
