# Backend Supabase service role configuration required by backend/db/supabase.js
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Agent 8 Omnichannel Communication Engine (do not commit real secrets)
COMMUNICATION_ENGINE_ENABLED=true
COMMUNICATION_WORKER_ENABLED=true
COMMUNICATION_WORKER_SECRET=
COMMUNICATION_WORKER_BATCH_SIZE=10
COMMUNICATION_PROCESSING_STALE_SECONDS=900
COMMUNICATION_MAX_ATTEMPTS=5
COMMUNICATION_RETRY_BASE_MS=60000
COMMUNICATION_AI_MODE_DEFAULT=enabled
COMMUNICATION_SLA_URGENT_MINUTES=15
COMMUNICATION_SLA_HIGH_MINUTES=60
COMMUNICATION_SLA_NORMAL_MINUTES=480
COMMUNICATION_SLA_LOW_MINUTES=1440
COMMUNICATION_FAKE_ADAPTERS_ENABLED=false
CARUP_CHANNEL_WEBHOOK_SECRET=
CARUP_META_WEBHOOK_VERIFY_TOKEN=
CARUP_META_APP_SECRET=
CARUP_META_ACCESS_TOKEN=
CARUP_META_PHONE_NUMBER_ID=
CARUP_META_PAGE_ID=
CARUP_TELEGRAM_BOT_TOKEN=
CARUP_TELEGRAM_WEBHOOK_SECRET_TOKEN=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=CarUp
SENDGRID_EVENT_WEBHOOK_VERIFICATION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=

# Optional OCR/provider configuration
OCR_MODE=loose
OCR_PRIMARY_PROVIDER=gemini
OCR_FALLBACK_PROVIDER=groq
ALLOW_OCR_MOCK=true
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional event worker database URL. Do not hard-code production credentials in source.
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# Optional automation hooks
ENABLE_AUTOMATION_WEBHOOKS=false
AUTOMATION_PROVIDER=n8n
AUTOMATION_WEBHOOK_URL=

# Optional live Diaspora Supabase integration validation
# RUN_DIASPORA_SUPABASE_INTEGRATION=true
# APPLY_DIASPORA_MIGRATION=true
# SUPABASE_DB_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
