{
  "$schema": "../schemas/token-package.schema.json",
  "meta": {
    "name": "carup-design-tokens",
    "version": "1.0.0-s1.1",
    "programme": "CARUP-UX-REBUILD-01",
    "stage": "RX-02A S1-1",
    "contract": "docs/product-experience/UI_DESIGN_REFERENCE_AND_TOKENS.md v1.1 (merged via PR #260 @ 0cfa3b652f1a2beb1396caecdb8d166501dfa53f)",
    "governingVisualAuthority": "DESIGN.md",
    "sourceOfTruth": true,
    "note": "Single machine-checkable token source. Generated outputs: web/src/styles/tokens.css + web/tailwind.tokens.js via scripts/build-tokens.mjs. Do not edit generated files by hand; run `npm run tokens:build`."
  },
  "fonts": {
    "sans": {
      "family": "Inter",
      "stack": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "weightsShipped": [400, 500, 600, 700],
      "weightsDeprecated": [300, 800, 900],
      "source": "self-hosted (web/src/styles/fonts.css, data-URI woff2)",
      "display": "swap"
    },
    "mono": {
      "family": "JetBrains Mono",
      "stack": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
      "weightsShipped": [400, 500],
      "source": "self-hosted (web/src/styles/fonts.css, data-URI woff2)"
    }
  },
  "raw": {
    "ink": "#0B1526",
    "ink-2": "#13233D",
    "navy": "#0F2440",
    "paper": "#FAFAF7",
    "surface": "#F1F1ED",
    "surface-2": "#E9E9E4",
    "line": "#E0E0DA",
    "line-strong": "#C9C9C2",
    "action": "#C2410C",
    "action-hover": "#9A3412",
    "action-soft": "#FBEADF",
    "orange-signal": "#F97316"
  },
  "semantic": {
    "light": {
      "color-bg": "paper",
      "color-bg-surface": "surface",
      "color-bg-surface-2": "surface-2",
      "color-bg-raised": "#FFFFFF",
      "color-line": "line",
      "color-line-strong": "line-strong",
      "color-text": "#191D27",
      "color-text-2": "#59616F",
      "color-text-3": "#5A6572",
      "color-action": "action",
      "color-action-hover": "action-hover",
      "color-action-on": "#FFFFFF",
      "color-action-soft": "action-soft",
      "color-focus": "action"
    },
    "darkBody": {
      "_note": "Token-complete per contract but INERT until Owner D-07 swatch sign-off. Emitted only under the .carup-theme-dark-body scope; no runtime toggle ships in S1-1.",
      "color-bg": "#0B1526",
      "color-bg-surface": "#13233D",
      "color-bg-surface-2": "#1D2A42",
      "color-bg-raised": "#24344F",
      "color-line": "rgba(255,255,255,0.12)",
      "color-line-strong": "rgba(255,255,255,0.22)",
      "color-text": "#F4F6F9",
      "color-text-2": "#C3CBD6",
      "color-text-3": "#9AA5B4",
      "color-action": "#FB7A3C",
      "color-action-hover": "#F97316",
      "color-action-on": "#1A0D05",
      "color-action-soft": "rgba(251,122,60,0.14)",
      "color-focus": "#FB7A3C"
    }
  },
  "status": {
    "success": { "lightInk": "#166534", "lightSoft": "#E7F3EB", "darkInk": "#4ADE80", "darkSoftRgba": "rgba(74,222,128,0.12)", "rule": "confirmed fact with source" },
    "warning": { "lightInk": "#92400E", "lightSoft": "#FAF0E3", "darkInk": "#FBBF24", "darkSoftRgba": "rgba(251,191,36,0.12)", "rule": "stale, pending, estimate" },
    "danger":  { "lightInk": "#B91C1C", "lightSoft": "#F9ECEC", "darkInk": "#F87171", "darkSoftRgba": "rgba(248,113,113,0.12)", "rule": "failed, overdue, blocked" },
    "info":    { "lightInk": "#1D4ED8", "lightSoft": "#EAF0FD", "darkInk": "#93C5FD", "darkSoftRgba": "rgba(147,197,253,0.12)", "rule": "in-progress, informational" },
    "neutral": { "lightInk": "#475569", "lightSoft": "#EEF1F5", "darkInk": "#A8B1BE", "darkSoftRgba": "rgba(168,177,190,0.12)", "rule": "not started, unmeasured, unknown" },
    "action":  { "lightInk": "action-hover", "lightSoft": "action-soft", "darkInk": "#FB7A3C", "darkSoftRgba": "rgba(251,122,60,0.14)", "rule": "user-actionable emphasis" }
  },
  "darkSoftBase": "#13233D",
  "spacing": [4, 8, 12, 16, 20, 24, 32, 40, 48],
  "radius": { "chrome": 2, "control": 6, "card": 12 },
  "type": {
    "baseSizePx": 14,
    "baseLineHeight": 1.55,
    "display": { "maxWeight": 700, "sizePx": [20, 28], "lineHeight": [1.12, 1.2], "tracking": "-0.02em" },
    "captionMinPx": 10.5,
    "tabularNumerals": true
  },
  "breakpoints": [360, 768, 1024, 1440, 1920],
  "contentWidths": { "public": 1440, "workspace": 1560, "focused": 480 },
  "elevation": {
    "stickyCtaAndSheets": "0 -2px 24px rgba(11,21,38,0.16)"
  },
  "shadcnSlots": {
    "_comment": "Repinned semantic slots so the 51 existing shadcn primitives inherit the contract without per-file edits. Values are contract tokens; the generator converts to HSL triplets (the slots are consumed as hsl(var(--slot))).",
    "light": {
      "background": "paper",
      "foreground": "#191D27",
      "card": "#FFFFFF",
      "card-foreground": "#191D27",
      "popover": "#FFFFFF",
      "popover-foreground": "#191D27",
      "primary": "action",
      "primary-foreground": "#FFFFFF",
      "secondary": "surface",
      "secondary-foreground": "#191D27",
      "muted": "surface",
      "muted-foreground": "#59616F",
      "accent": "action-soft",
      "accent-foreground": "action-hover",
      "destructive": "#B91C1C",
      "destructive-foreground": "#FFFFFF",
      "border": "line",
      "input": "line-strong",
      "ring": "action",
      "radius": "0.375rem",
      "sidebar-background": "#0B1526",
      "sidebar-foreground": "#FAFAF7",
      "sidebar-primary": "action",
      "sidebar-primary-foreground": "#FFFFFF",
      "sidebar-accent": "#13233D",
      "sidebar-accent-foreground": "#FAFAF7",
      "sidebar-border": "rgba(255,255,255,0.12)",
      "sidebar-ring": "action"
    }
  }
}
