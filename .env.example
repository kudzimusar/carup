# ============================================================================
# CarUp OS — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in the required credentials.
# Do NOT commit live API keys or secrets to Git!
# ============================================================================

# Supabase Project Connection & Keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_ANON_KEY=

# Frontend Environment (Vite Prefix)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
VITE_PUBLIC_APP_URL=

# Public app origin used by backend-generated referral share links.
# Production: https://carup.dev
# Staging: https://staging.carup.dev
PUBLIC_APP_URL=
CARUP_PUBLIC_BASE_URL=

# AI Orchestrator API Keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=

# Session Security Configuration
JWT_SECRET=

# Automation Event Webhooks
ENABLE_AUTOMATION_WEBHOOKS=false
AUTOMATION_WEBHOOK_URL=

# Agent 8 Omnichannel Communication Engine
COMMUNICATION_ENGINE_ENABLED=true
COMMUNICATION_WORKER_SECRET=
COMMUNICATION_WORKER_BATCH_SIZE=10
COMMUNICATION_PROCESSING_STALE_SECONDS=900
COMMUNICATION_MAX_ATTEMPTS=5
COMMUNICATION_RETRY_BASE_MS=60000
COMMUNICATION_FAKE_ADAPTERS_ENABLED=false
CARUP_COMMUNICATION_WEBHOOK_UAT_DIAGNOSTICS=false
CARUP_CHANNEL_WEBHOOK_SECRET=
CARUP_META_WEBHOOK_VERIFY_TOKEN=
CARUP_META_APP_SECRET=
CARUP_META_ACCESS_TOKEN=
CARUP_META_PHONE_NUMBER_ID=
CARUP_META_PAGE_ID=
CARUP_TELEGRAM_BOT_TOKEN=
CARUP_TELEGRAM_WEBHOOK_SECRET_TOKEN=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=CarUp
SENDGRID_EVENT_WEBHOOK_VERIFICATION_KEY=
EMAIL_PROVIDER=sendgrid
EMAIL_PROVIDER_FALLBACK=

# --- Email 1.0 canonical transports (directive §0A) --------------------------
# Resend = transactional + conversational Email on mail.carup.dev.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@mail.carup.dev
RESEND_WEBHOOK_SECRET=
# Brevo = MARKETING ONLY on marketing.carup.dev. Never a competing transactional provider.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_WEBHOOK_SECRET=

# Free-tier quota governance. No provider may silently move CarUp into paid usage.
# Soft threshold warns; critical threshold preserves security/transactional/conversational
# capacity, defers lower-priority Email and suppresses marketing first. Capacity is never
# auto-purchased. Defaults live in backend/config/emailProviderQuota.js and sit below the
# provider ceilings recorded there (Resend 100/day, Brevo ~300/day as of 2026-08).
RESEND_DAILY_SOFT_LIMIT=
RESEND_DAILY_CRITICAL_LIMIT=
BREVO_DAILY_SOFT_LIMIT=
BREVO_DAILY_CRITICAL_LIMIT=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=
CLOUDFLARE_EMAIL_FROM_NAME=CarUp
CLOUDFLARE_EMAIL_REPLY_TO=
CLOUDFLARE_EMAIL_WORKER_URL=
CLOUDFLARE_EMAIL_WORKER_SECRET=
CLOUDFLARE_EMAIL_INBOUND_SECRET=
CLOUDFLARE_EMAIL_ALLOWED_RECIPIENTS=
CLOUDFLARE_EMAIL_MAX_BYTES=26214400
CLOUDFLARE_EMAIL_SIGNATURE_TOLERANCE_SECONDS=300
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_QUEUE_INBOUND=
CLOUDFLARE_QUEUE_OUTBOUND=
CLOUDFLARE_QUEUE_DLQ=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=
EXPO_ACCESS_TOKEN=
