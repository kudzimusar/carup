{
  "expo": {
    "name": "CarUp",
    "slug": "carup-mobile",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "scheme": "carup",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.carup.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.carup.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "CarUp needs access to your photos to upload documents.",
          "cameraPermission": "CarUp needs camera access to capture documents and selfies."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CarUp to use Face ID for authentication."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
